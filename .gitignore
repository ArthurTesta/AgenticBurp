__pycache__/
*.pyc
.pytest_cache/
.review-deps/

# Local-only config overrides, never committed (SESSION_4_PLAN.md T0.1)
config.local.yaml

# Build output and runtime SQLite DBs (SESSION_4_PLAN.md T0.2)
*.jar
harness/*.db
harness/run-output/

# score.py results (regenerable from the fixture)
testing/**/scorecard.json
testing/**/fixture/

# Captured run artifacts can carry live target session tokens (JWTs/cookies) --
# keep them out of git so a browse/run capture never leaks a secret into history.
testing/**/run-*-results/
testing/**/exports/
testing/**/uploads/

# --- Local test environments & run artifacts (never commit) -----------------
# Git worktrees created under the repo must never be tracked -- they are stored
# as gitlinks that point at local-only commits and break clones.
.worktrees/

# Disposable local target apps + their run outputs, DBs, logs, secrets and
# answer keys. These are recreated locally; committing them leaks target
# answer keys/secrets and bloats history. (Extends "ignore local test envs".)
testing/vulncorp-helpdesk/
testing/blind-target-2/
testing/blind-test-kit/target/
testing/juiceshop-full-run/
testing/test-target/
testing/**/maxrun/
testing/**/*.db
testing/**/*.log
testing/**/*answerkey*.json

# Large raw test-output dumps
review_test_output.txt
